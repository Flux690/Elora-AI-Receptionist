{
  "name": "backend",
  "version": "0.1.0",
  "type": "module",
  "description": "Backend API and LiveKit agent worker",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "agent": "tsx ./src/agent/worker.ts dev",
    "agent:download": "tsx ./src/agent/worker.ts download-files",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "echo \"No tests configured yet\" && exit 0"
  },
  "keywords": [
    "livekit",
    "voice-agent",
    "neon",
    "drizzle",
    "typescript"
  ],
  "author": "Prabhat Mattoo",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1063.0",
    "@aws-sdk/s3-request-presigner": "3.1063.0",
    "@clerk/backend": "3.5.0",
    "@clerk/hono": "0.1.33",
    "@hono/node-server": "2.0.4",
    "@livekit/agents": "1.4.5",
    "@livekit/agents-plugin-livekit": "1.4.5",
    "@livekit/agents-plugin-openai": "1.4.5",
    "@livekit/agents-plugin-silero": "1.4.5",
    "@livekit/noise-cancellation-node": "0.1.9",
    "@receptionist/shared": "workspace:*",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.23",
    "livekit-server-sdk": "2.15.4",
    "openai": "4.104.0",
    "pg": "8.21.0",
    "svix": "1.95.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.13.1",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
