{
  "name": "backend",
  "private": true,
  "type": "module",
  "description": "Backend API and LiveKit agent worker",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "agent": "tsx ./src/agent/worker.ts dev",
    "agent:download": "tsx ./src/agent/worker.ts download-files",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:int": "DATABASE_URL=postgresql://deskroute:deskroute@localhost:5433/deskroute_test drizzle-kit migrate && vitest run --project int",
    "test:live": "vitest run --project live"
  },
  "keywords": [
    "livekit",
    "voice-agent",
    "drizzle",
    "typescript"
  ],
  "author": "Prabhat Mattoo",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1063.0",
    "@aws-sdk/s3-request-presigner": "3.1063.0",
    "@clerk/backend": "3.5.0",
    "@clerk/hono": "0.1.33",
    "@hono/node-server": "2.0.4",
    "@livekit/agents": "1.6.4",
    "@livekit/agents-plugin-openai": "1.6.4",
    "@livekit/agents-plugin-silero": "1.6.4",
    "@livekit/noise-cancellation-node": "0.2.0",
    "@livekit/protocol": "1.50.4",
    "@livekit/rtc-node": "0.13.33",
    "@receptionist/shared": "workspace:*",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.23",
    "livekit-server-sdk": "2.17.0",
    "pg": "8.21.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.13.1",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
